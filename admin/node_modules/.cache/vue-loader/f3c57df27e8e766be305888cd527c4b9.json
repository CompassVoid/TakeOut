{"remainingRequest":"D:\\WaiMai\\admin\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\WaiMai\\admin\\src\\views\\modules\\caipin\\list.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\WaiMai\\admin\\src\\views\\modules\\caipin\\list.vue","mtime":1766995556000},{"path":"D:\\WaiMai\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\WaiMai\\admin\\node_modules\\babel-loader\\lib\\index.js","mtime":456789000000},{"path":"D:\\WaiMai\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\WaiMai\\admin\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["list.vue"],"names":[],"mappings":";AAgKA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"list.vue","sourceRoot":"src/views/modules/caipin","sourcesContent":["<template>\r\n  <div class=\"main-content\">\r\n    <!-- 列表页 -->\r\n    <div v-if=\"showFlag\">\r\n      <el-form :inline=\"true\" :model=\"searchForm\" class=\"form-content\">\r\n                                            <el-form-item label=\"名称\">\r\n                <el-input v-model=\"searchForm.mingcheng\" \r\n                    placeholder=\"名称\" clearable></el-input>\r\n              </el-form-item>\r\n                                                                  <el-form-item label=\"类型\">\r\n                <el-input v-model=\"searchForm.leixing\" \r\n                    placeholder=\"类型\" clearable></el-input>\r\n              </el-form-item>\r\n                                                                                                                                                                    <el-form-item>\r\n          <el-button round @click=\"search()\">查询</el-button>\r\n          <el-button\r\n            v-if=\"isAuth('caipin','新增')\"\r\n            type=\"primary\"\r\n            @click=\"addOrUpdateHandler()\"\r\n            round\r\n          >新增</el-button>\r\n          <el-button\r\n            v-if=\"isAuth('caipin','删除')\"\r\n            :disabled=\"dataListSelections.length <= 0\"\r\n            type=\"danger\"\r\n            @click=\"deleteHandler()\"\r\n            round\r\n          >删除</el-button>\r\n                  </el-form-item>\r\n      </el-form>\r\n      <div class=\"table-content\">\r\n        <el-table\r\n            v-if=\"isAuth('caipin','查看')\"\r\n            :data=\"dataList\"\r\n            border\r\n            v-loading=\"dataListLoading\"\r\n            @selection-change=\"selectionChangeHandler\"\r\n            style=\"width: 100%;\">\r\n            <el-table-column\r\n                type=\"selection\"\r\n                header-align=\"center\"\r\n                align=\"center\"\r\n                width=\"50\">\r\n            </el-table-column>\r\n                                            <el-table-column\r\n                    prop=\"mingcheng\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"名称\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.mingcheng}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"leixing\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"类型\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.leixing}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                              <el-table-column prop=\"tupian\" \r\n                    header-align=\"center\"\r\n                    align=\"center\" \r\n                    width=\"200\" \r\n                    label=\"图片\">\r\n                    <template slot-scope=\"scope\">\r\n                      <div v-if=\"scope.row.tupian\">\r\n                        <img :src=\"scope.row.tupian.split(',')[0]\" width=\"100\" height=\"100\">\r\n                      </div>\r\n                      <div v-else>无图片</div>\r\n                    </template>\r\n                  </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"kouwei\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"口味\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.kouwei}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"jiage\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"价格\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.jiage}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"shangjiabianhao\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"商家编号\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.shangjiabianhao}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"shangjiamingcheng\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"商家名称\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.shangjiamingcheng}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"dizhi\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"地址\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.dizhi}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                                                                <el-table-column\r\n                header-align=\"center\"\r\n                align=\"center\"\r\n                label=\"操作\">\r\n                <template slot-scope=\"scope\">\n                                <el-button v-if=\"isAuth('caipin','查看')\" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"addOrUpdateHandler(scope.row.id,'info')\">详情</el-button>\n                                                                <el-button v-if=\"isAuth('caipin','加入订餐车')\" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"dingdanCrossAddOrUpdateHandler(scope.row,'cross')\">加入订餐车</el-button>\n                                                                <el-button v-if=\"isAuth('caipin','加入订餐车')\" type=\"text\" icon=\"el-icon-shopping-cart-full\" size=\"small\" @click=\"addToCart(scope.row)\">加入购物车</el-button>\n                                                                <el-button v-if=\"isAuth('caipin','修改')\" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"addOrUpdateHandler(scope.row.id)\">修改</el-button>\n                <el-button v-if=\"isAuth('caipin','删除')\" type=\"text\" icon=\"el-icon-delete\" size=\"small\" @click=\"deleteHandler(scope.row.id)\">删除</el-button>\n                </template>\n            </el-table-column>\r\n        </el-table>\r\n                                                                                                                                                                <el-pagination\r\n          @size-change=\"sizeChangeHandle\"\r\n          @current-change=\"currentChangeHandle\"\r\n          :current-page=\"pageIndex\"\r\n          :page-sizes=\"[10, 20, 50, 100]\"\r\n          :page-size=\"pageSize\"\r\n          :total=\"totalPage\"\r\n          layout=\"total, sizes, prev, pager, next, jumper\"\r\n          class=\"pagination-content\"\r\n        ></el-pagination>\r\n      </div>\r\n    </div>\r\n    <!-- 添加/修改页面  将父组件的search方法传递给子组件-->\r\n    <add-or-update v-if=\"addOrUpdateFlag\" :parent=\"this\" ref=\"addOrUpdate\"></add-or-update>\r\n\r\n            <dingdan-cross-add-or-update v-if=\"dingdanCrossAddOrUpdateFlag\" :parent=\"this\" ref=\"dingdanCrossaddOrUpdate\"></dingdan-cross-add-or-update>\r\n        \r\n    \r\n      </div>\r\n</template>\r\n<script>\r\nimport AddOrUpdate from \"./add-or-update\";\r\nimport dingdanCrossAddOrUpdate from \"../dingdan/add-or-update\";\r\nexport default {\r\n  data() {\r\n    return {\r\n                                                            leixingOptions: [],\r\n                                                                                                                                                      searchForm: {\r\n        key: \"\"\r\n      },\r\n      dataList: [],\r\n      pageIndex: 1,\r\n      pageSize: 10,\r\n      totalPage: 0,\r\n      dataListLoading: false,\r\n      dataListSelections: [],\r\n      showFlag: true,\r\n      sfshVisiable: false,\r\n      shForm: {},\r\n      chartVisiable: false,\r\n      addOrUpdateFlag:false,\r\n                  dingdanCrossAddOrUpdateFlag: false,\r\n                };\r\n  },\r\n  mounted() {\r\n    this.init();\r\n    this.getDataList();\r\n  },\r\n  filters: {\r\n    htmlfilter: function (val) {\r\n      return val.replace(/<[^>]*>/g).replace(/undefined/g,'');\r\n    }\r\n  },\r\n  components: {\r\n    AddOrUpdate,\r\n            dingdanCrossAddOrUpdate,\r\n  },\n  methods: {\n            dingdanCrossAddOrUpdateHandler(row,type){\n      this.showFlag = false;\n      this.addOrUpdateFlag = false;\n      this.dingdanCrossAddOrUpdateFlag = true;\n      this.$storage.set('crossObj',row);\n      this.$storage.set('crossTable','caipin');\n      this.$nextTick(() => {\n        this.$refs.dingdanCrossaddOrUpdate.init(row.id,type);\n      });\n    },\n    addToCart(row){\n      const cart = this.$storage.getObj('cartItems') || []\n      const found = cart.find(item => item.id === row.id)\n      if(found){\n        found.goumaishuliang = (found.goumaishuliang || found.quantity || 1) + 1\n      }else{\n        cart.push({\n          id: row.id,\n          mingcheng: row.mingcheng,\n          leixing: row.leixing,\n          tupian: row.tupian,\n          jiage: row.jiage,\n          shangjiabianhao: row.shangjiabianhao,\n          shangjiamingcheng: row.shangjiamingcheng,\n          goumaishuliang: 1\n        })\n      }\n      this.$storage.set('cartItems', cart)\n      this.$message.success('已加入购物车')\n    },\n                    init () {\n                                                        this.$http({\n            url: `option/caipinfenlei/leixing`,\n            method: \"get\"\n          }).then(({ data }) => {\r\n            if (data && data.code === 0) {\r\n              this.leixingOptions = data.data;\r\n            } else {\r\n              this.$message.error(data.msg);\r\n            }\r\n          });\r\n                                                                                                                                                                                                                                                },\r\n    search() {\r\n      this.pageIndex = 1;\r\n      this.getDataList();\r\n    },\r\n    // 获取数据列表\r\n    getDataList() {\r\n      this.dataListLoading = true;\r\n      let params = {\r\n        page: this.pageIndex,\r\n        limit: this.pageSize,\r\n        sort: 'id',\r\n      }\r\n                                          if(this.searchForm.mingcheng!='' && this.searchForm.mingcheng!=undefined){\r\n            params['mingcheng'] = '%' + this.searchForm.mingcheng + '%'\r\n          }\r\n                                                            if(this.searchForm.leixing!='' && this.searchForm.leixing!=undefined){\r\n            params['leixing'] = '%' + this.searchForm.leixing + '%'\r\n          }\r\n                                                                                                                                                                                        this.$http({\r\n        url: \"caipin/page\",\r\n        method: \"get\",\r\n        params: params\r\n      }).then(({ data }) => {\r\n        if (data && data.code === 0) {\r\n          this.dataList = data.data.list;\r\n          this.totalPage = data.data.total;\r\n        } else {\r\n          this.dataList = [];\r\n          this.totalPage = 0;\r\n        }\r\n        this.dataListLoading = false;\r\n      });\r\n    },\r\n    // 每页数\r\n    sizeChangeHandle(val) {\r\n      this.pageSize = val;\r\n      this.pageIndex = 1;\r\n      this.getDataList();\r\n    },\r\n    // 当前页\r\n    currentChangeHandle(val) {\r\n      this.pageIndex = val;\r\n      this.getDataList();\r\n    },\r\n    // 多选\r\n    selectionChangeHandler(val) {\r\n      this.dataListSelections = val;\r\n    },\r\n    // 添加/修改\r\n    addOrUpdateHandler(id,type) {\r\n      this.showFlag = false;\r\n      this.addOrUpdateFlag = true;\r\n      this.crossAddOrUpdateFlag = false;\r\n      if(type!='info'){\r\n        type = 'else';\r\n      }\r\n      this.$nextTick(() => {\r\n        this.$refs.addOrUpdate.init(id,type);\r\n      });\r\n    },\r\n        // 下载\r\n    download(file){\r\n      window.open(`${file}`)\r\n    },\r\n    // 删除\r\n    deleteHandler(id) {\r\n      var ids = id\r\n        ? [Number(id)]\r\n        : this.dataListSelections.map(item => {\r\n            return Number(item.id);\r\n          });\r\n      this.$confirm(`确定进行[${id ? \"删除\" : \"批量删除\"}]操作?`, \"提示\", {\r\n        confirmButtonText: \"确定\",\r\n        cancelButtonText: \"取消\",\r\n        type: \"warning\"\r\n      }).then(() => {\r\n        this.$http({\r\n          url: \"caipin/delete\",\r\n          method: \"post\",\r\n          data: ids\r\n        }).then(({ data }) => {\r\n          if (data && data.code === 0) {\r\n            this.$message({\r\n              message: \"操作成功\",\r\n              type: \"success\",\r\n              duration: 1500,\r\n              onClose: () => {\r\n                this.search();\r\n              }\r\n            });\r\n          } else {\r\n            this.$message.error(data.msg);\r\n          }\r\n        });\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n<style lang=\"scss\" scoped>\r\n</style>\r\n"]}]}