         <el-input v-model=\"ruleForm.mingcheng\" \r\n                placeholder=\"名称\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item v-if=\"type!='info'\"  label=\"类型\" prop=\"leixing\">\r\n          <el-select v-model=\"ruleForm.leixing\" placeholder=\"请选择类型\">\r\n            <el-option\r\n                v-for=\"(item,index) in leixingOptions\"\r\n                v-bind:key=\"index\"\r\n                :label=\"item\"\r\n                :value=\"item\">\r\n            </el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.leixing\" label=\"类型\" prop=\"leixing\">\r\n              <el-input v-model=\"ruleForm.leixing\" \r\n                placeholder=\"类型\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"24\">  \r\n        <el-form-item v-if=\"type!='info'\" label=\"图片\" prop=\"tupian\">\r\n          <file-upload\r\n          tip=\"点击上传图片\"\r\n          action=\"file/upload\"\r\n          :limit=\"3\"\r\n          :multiple=\"true\"\r\n          :fileUrls=\"ruleForm.tupian?ruleForm.tupian:''\"\r\n          @change=\"tupianUploadChange\"\r\n          ></file-upload>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.tupian\" label=\"图片\" prop=\"tupian\">\r\n            <img style=\"margin-right:20px;\" v-bind:key=\"index\" v-for=\"(item,index) in ruleForm.tupian.split(',')\" :src=\"item\" width=\"100\" height=\"100\">\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item  v-if=\"type!='info'\"  label=\"口味\" prop=\"kouwei\">\r\n          <el-input v-model=\"ruleForm.kouwei\" \r\n              placeholder=\"口味\" clearable></el-input>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.kouwei\" label=\"口味\" prop=\"kouwei\">\r\n              <el-input v-model=\"ruleForm.kouwei\" \r\n                placeholder=\"口味\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item  v-if=\"type!='info'\"  label=\"价格\" prop=\"jiage\">\r\n          <el-input v-model=\"ruleForm.jiage\" \r\n              placeholder=\"价格\" clearable></el-input>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.jiage\" label=\"价格\" prop=\"jiage\">\r\n              <el-input v-model=\"ruleForm.jiage\" \r\n                placeholder=\"价格\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item  v-if=\"type!='info'\"  label=\"商家编号\" prop=\"shangjiabianhao\">\r\n          <el-input v-model=\"ruleForm.shangjiabianhao\" \r\n              placeholder=\"商家编号\" clearable></el-input>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.shangjiabianhao\" label=\"商家编号\" prop=\"shangjiabianhao\">\r\n              <el-input v-model=\"ruleForm.shangjiabianhao\" \r\n                placeholder=\"商家编号\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item  v-if=\"type!='info'\"  label=\"商家名称\" prop=\"shangjiamingcheng\">\r\n          <el-input v-model=\"ruleForm.shangjiamingcheng\" \r\n              placeholder=\"商家名称\" clearable></el-input>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.shangjiamingcheng\" label=\"商家名称\" prop=\"shangjiamingcheng\">\r\n              <el-input v-model=\"ruleForm.shangjiamingcheng\" \r\n                placeholder=\"商家名称\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item  v-if=\"type!='info'\"  label=\"地址\" prop=\"dizhi\">\r\n          <el-input v-model=\"ruleForm.dizhi\" \r\n              placeholder=\"地址\" clearable></el-input>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.dizhi\" label=\"地址\" prop=\"dizhi\">\r\n              <el-input v-model=\"ruleForm.dizhi\" \r\n                placeholder=\"地址\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                                          </el-row>\r\n                                                                                                                                                                                                                                                                            <el-row>\r\n            <el-col :span=\"24\">\r\n              <el-form-item v-if=\"type!='info'\"  label=\"菜品介绍\" prop=\"caipinjieshao\">\r\n                <editor \r\n                    style=\"min-width: 200px; max-width: 600px;\"\r\n                    v-model=\"ruleForm.caipinjieshao\" \r\n                    class=\"editor\" \r\n                    action=\"file/upload\">\r\n                </editor>\r\n              </el-form-item>\r\n              <div v-else>\r\n                <el-form-item v-if=\"ruleForm.caipinjieshao\" label=\"菜品介绍\" prop=\"caipinjieshao\">\r\n                    <span v-html=\"ruleForm.caipinjieshao\"></span>\r\n                </el-form-item>\r\n              </div>\r\n            </el-col>\r\n          </el-row>\r\n                    <el-form-item>\r\n                <el-button v-if=\"type!='info'\" type=\"primary\" @click=\"onSubmit\">提交</el-button>\r\n        <el-button v-if=\"type!='info'\" @click=\"back()\">取消</el-button>\r\n        <el-button v-if=\"type=='info'\" @click=\"back()\">返回</el-button>\r\n      </el-form-item>\r\n    </el-form>\r\n    \r\n    \r\n  </div>\r\n</template>\r\n<script>\r\n// 数字，邮件，手机，url，身份证校验\r\nimport { isNumber,isIntNumer,isEmail,isMobile,isURL,checkIdCard } from \"@/utils/validate\";\r\nexport default {\r\n  data() {\r\n    let self = this\r\n    var validateIdCard = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!checkIdCard(value)) {\r\n        callback(new Error(\"请输入正确的身份证号码\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validateUrl = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isURL(value)) {\r\n        callback(new Error(\"请输入正确的URL地址\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validatePhone = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isMobile(value)) {\r\n        callback(new Error(\"请输入正确的电话号码\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validateEmail = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isEmail(value)) {\r\n        callback(new Error(\"请输入正确的邮箱地址\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validateNumber = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isNumber(value)) {\r\n        callback(new Error(\"请输入数字\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validateIntNumber = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isIntNumer(value)) {\r\n        callback(new Error(\"请输入整数\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    return {\r\n      id: '',\r\n      type: '',\r\n            ruleForm: {\r\n                        mingcheng: '',\r\n                                leixing: '',\r\n                                tupian: '',\r\n                                kouwei: '',\r\n                                jiage: '',\r\n                                shangjiabianhao: '',\r\n                                shangjiamingcheng: '',\r\n                                dizhi: '',\r\n                                caipinjieshao: '',\r\n                      },\r\n                                      leixingOptions: [],\r\n                                                                                                                      rules: {\r\n                  mingcheng: [\r\n                            { required: true, message: '名称不能为空', trigger: 'blur' },\r\n                                                                                              ],\r\n                  leixing: [\r\n                                                                                              ],\r\n                  tupian: [\r\n                                                                                              ],\r\n                  kouwei: [\r\n                                                                                              ],\r\n                  jiage: [\r\n                            { required: true, message: '价格不能为空', trigger: 'blur' },\r\n                                        { validator: validateIntNumber, trigger: 'blur' },\r\n                                                                                  ],\r\n                  shangjiabianhao: [\r\n                                                                                              ],\r\n                  shangjiamingcheng: [\r\n                                                                                              ],\r\n                  dizhi: [\r\n                                                                                              ],\r\n                  caipinjieshao: [\r\n                                                                                              ],\r\n              }\r\n    };\r\n  },\r\n  props: [\"parent\"],\r\n  computed: {\r\n                                                                                                                  },\r\n  methods: {\r\n        // 下载\r\n    download(file){\r\n      window.open(`${file}`)\r\n    },\r\n    // 初始化\r\n    init(id,type) {\r\n      if (id) {\r\n        this.id = id;\r\n        this.type = type;\r\n      }\r\n      if(this.type=='info'||this.type=='else'){\r\n        this.info(id);\r\n      }else if(this.type=='cross'){\r\n        var obj = this.$storage.getObj('crossObj');\r\n        for (var o in obj){\r\n                    if(o=='mingcheng'){\r\n            this.ruleForm.mingcheng = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='leixing'){\r\n            this.ruleForm.leixing = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='tupian'){\r\n            this.ruleForm.tupian = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='kouwei'){\r\n            this.ruleForm.kouwei = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='jiage'){\r\n            this.ruleForm.jiage = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='shangjiabianhao'){\r\n            this.ruleForm.shangjiabianhao = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='shangjiamingcheng'){\r\n            this.ruleForm.shangjiamingcheng = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='dizhi'){\r\n            this.ruleForm.dizhi = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='caipinjieshao'){\r\n            this.ruleForm.caipinjieshao = obj[o];\r\n            continue;\r\n          }\r\n                  }\r\n                                                                                                                                                              }\r\n            // 获取用户信息\r\n      this.$http({\r\n        url: `${this.$storage.get('sessionTable')}/session`,\r\n        method: \"get\"\r\n      }).then(({ data }) => {\r\n        if (data && data.code === 0) {\r\n          var json = data.data;\r\n                                                                                                                                                  this.ruleForm.shangjiabianhao = json.shangjiabianhao\r\n                                                this.ruleForm.shangjiamingcheng = json.shangjiamingcheng\r\n                                                this.ruleForm.dizhi = json.dizhi\r\n                                                    } else {\r\n          this.$message.error(data.msg);\r\n        }\r\n      });\r\n                                                            this.$http({\r\n              url: `option/caipinfenlei/leixing`,\r\n              method: \"get\"\r\n            }).then(({ data }) => {\r\n              if (data && data.code === 0) {\r\n                this.leixingOptions = data.data;\r\n              } else {\r\n                this.$message.error(data.msg);\r\n              }\r\n            });\r\n         \r\n                                                                                                                                                          },\r\n                                                                                // 多级联动参数\r\n                                                                                                      info(id) {\r\n      this.$http({\r\n        url: `caipin/info/${id}`,\r\n        method: \"get\"\r\n      }).then(({ data }) => {\r\n        if (data && data.code === 0) {\r\n          this.ruleForm = data.data;\r\n        } else {\r\n          this.$message.error(data.msg);\r\n        }\r\n      });\r\n    },\r\n        // 提交\r\n    onSubmit() {\r\n                  // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                                                                                                                                                                                                      this.$refs[\"ruleForm\"].validate(valid => {\r\n        if (valid) {\r\n          this.$http({\r\n            url: `caipin/${!this.ruleForm.id ? \"save\" : \"update\"}`,\r\n            method: \"post\",\r\n            data: this.ruleForm\r\n          }).then(({ data }) => {\r\n            if (data && data.code === 0) {\r\n              this.$message({\r\n                message: \"操作成功\",\r\n                type: \"success\",\r\n                duration: 1500,\r\n                onClose: () => {\r\n                  this.parent.showFlag = true;\r\n                  this.parent.addOrUpdateFlag = false;\r\n                  this.parent.caipinCrossAddOrUpdateFlag = false;\r\n                  this.parent.search();\r\n                }\r\n              });\r\n            } else {\r\n              this.$message.error(data.msg);\r\n            }\r\n          });\r\n        }\r\n      });\r\n    },\r\n    // 获取uuid\r\n    getUUID () {\r\n      return new Date().getTime();\r\n    },\r\n    // 返回\r\n    back() {\r\n      this.parent.showFlag = true;\r\n      this.parent.addOrUpdateFlag = false;\r\n      this.parent.caipinCrossAddOrUpdateFlag = false;\r\n    },\r\n                                                tupianUploadChange(fileUrls) {\r\n                this.ruleForm.tupian = fileUrls;\r\n            },\r\n                                                                                      }\r\n};\r\n</script>\r\n<style lang=\"scss\">\r\n.editor{\r\n  height: 500px;\r\n}\r\n.amap-wrapper {\r\n  width: 100%;\r\n  height: 500px;\r\n}\r\n.search-box {\r\n  position: absolute;\r\n}\r\n</style>\r\n"]}]}