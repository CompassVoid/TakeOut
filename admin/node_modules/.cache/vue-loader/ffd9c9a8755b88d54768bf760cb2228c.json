{"remainingRequest":"D:\\WaiMai\\admin\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\WaiMai\\admin\\src\\views\\modules\\dingdan\\list.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\WaiMai\\admin\\src\\views\\modules\\dingdan\\list.vue","mtime":1766995738945},{"path":"D:\\WaiMai\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\WaiMai\\admin\\node_modules\\babel-loader\\lib\\index.js","mtime":456789000000},{"path":"D:\\WaiMai\\admin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":499162500000},{"path":"D:\\WaiMai\\admin\\node_modules\\vue-loader\\lib\\index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["list.vue"],"names":[],"mappings":";AAoRA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"list.vue","sourceRoot":"src/views/modules/dingdan","sourcesContent":["<template>\r\n  <div class=\"main-content\">\r\n    <!-- 列表页 -->\r\n    <div v-if=\"showFlag\">\r\n      <el-form :inline=\"true\" :model=\"searchForm\" class=\"form-content\">\r\n                                            <el-form-item label=\"名称\">\r\n                <el-input v-model=\"searchForm.mingcheng\" \r\n                    placeholder=\"名称\" clearable></el-input>\r\n              </el-form-item>\r\n                                                                  <el-form-item label=\"类型\">\r\n                <el-input v-model=\"searchForm.leixing\" \r\n                    placeholder=\"类型\" clearable></el-input>\r\n              </el-form-item>\r\n                                                                                                                                          <el-form-item label=\"商家编号\">\r\n                <el-input v-model=\"searchForm.shangjiabianhao\" \r\n                    placeholder=\"商家编号\" clearable></el-input>\r\n              </el-form-item>\r\n                                                                                                      <el-form-item label=\"手机\">\r\n                <el-input v-model=\"searchForm.shouji\" \r\n                    placeholder=\"手机\" clearable></el-input>\r\n              </el-form-item>\r\n                                                                                                                                                                                                        <el-form-item>\r\n          <el-button round @click=\"search()\">查询</el-button>\r\n          <el-button\r\n            v-if=\"isAuth('dingdan','新增')\"\r\n            type=\"primary\"\r\n            @click=\"addOrUpdateHandler()\"\r\n            round\r\n          >新增</el-button>\r\n          <el-button\r\n            v-if=\"isAuth('dingdan','删除')\"\r\n            :disabled=\"dataListSelections.length <= 0\"\r\n            type=\"danger\"\r\n            @click=\"deleteHandler()\"\r\n            round\r\n          >删除</el-button>\r\n                  </el-form-item>\r\n      </el-form>\r\n      <div class=\"table-content\">\r\n        <el-table\r\n            v-if=\"isAuth('dingdan','查看')\"\r\n            :data=\"dataList\"\r\n            border\r\n            v-loading=\"dataListLoading\"\r\n            @selection-change=\"selectionChangeHandler\"\r\n            style=\"width: 100%;\">\r\n            <el-table-column\r\n                type=\"selection\"\r\n                header-align=\"center\"\r\n                align=\"center\"\r\n                width=\"50\">\r\n            </el-table-column>\r\n                                            <el-table-column\r\n                    prop=\"mingcheng\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"名称\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.mingcheng}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"leixing\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"类型\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.leixing}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                              <el-table-column prop=\"tupian\" \r\n                    header-align=\"center\"\r\n                    align=\"center\" \r\n                    width=\"200\" \r\n                    label=\"图片\">\r\n                    <template slot-scope=\"scope\">\r\n                      <div v-if=\"scope.row.tupian\">\r\n                        <img :src=\"scope.row.tupian.split(',')[0]\" width=\"100\" height=\"100\">\r\n                      </div>\r\n                      <div v-else>无图片</div>\r\n                    </template>\r\n                  </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"jiage\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"价格\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.jiage}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"goumaishuliang\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"购买数量\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.goumaishuliang}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"zongjiage\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"总价格\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.zongjiage}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"shangjiabianhao\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"商家编号\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.shangjiabianhao}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"shangjiamingcheng\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"商家名称\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.shangjiamingcheng}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"zhanghao\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"账号\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.zhanghao}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"shouji\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"手机\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.shouji}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"qishoushouyi\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"骑手收益\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.qishoushouyi}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"xiadanshijian\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"下单时间\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.xiadanshijian}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"beizhu\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"备注\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.beizhu}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                                                                                                                    <el-table-column\r\n                  prop=\"ispay\"\r\n                  header-align=\"center\"\r\n                  align=\"center\"\r\n                  sortable\r\n                  label=\"是否支付\">\r\n                  <template slot-scope=\"scope\">\r\n                    <span style=\"margin-right:10px\">{{scope.row.ispay=='已支付'?'已支付':'未支付'}}</span>\r\n                    <el-button v-if=\"scope.row.ispay!='已支付' && isAuth('dingdan','支付') \" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"payHandler(scope.row)\">支付</el-button>\r\n                  </template>\r\n                </el-table-column>\r\n                                                                                                                                                    <el-table-column\r\n                    prop=\"fulladdress\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"地址\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.fulladdress}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                      <el-table-column\r\n                  prop=\"shhf\"\r\n                  header-align=\"center\"\r\n                  align=\"center\"\r\n                  sortable\r\n                  label=\"审核回复\">\r\n              </el-table-column>\r\n              <el-table-column\n                  v-if=\"isAuth('dingdan','审核')\"\n                  prop=\"sfsh\"\n                  header-align=\"center\"\n                  align=\"center\"\n                  sortable\n                  label=\"订单状态\">\n                  <template slot-scope=\"scope\">\n                    <span style=\"margin-right:10px\">{{scope.row.sfsh || '待接单'}}</span>\n                    <el-button  type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"shDialog(scope.row)\">更新状态</el-button>\n                  </template>\n              </el-table-column>\n                        <el-table-column\r\n                header-align=\"center\"\r\n                align=\"center\"\r\n                label=\"操作\">\r\n                <template slot-scope=\"scope\">\r\n                                <el-button v-if=\"isAuth('dingdan','查看')\" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"addOrUpdateHandler(scope.row.id,'info')\">详情</el-button>\r\n                                                                <el-button v-if=\"isAuth('dingdan','配送')\" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"peisongdanCrossAddOrUpdateHandler(scope.row,'cross')\">配送</el-button>\r\n                                                                <el-button v-if=\"isAuth('dingdan','修改')\" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"addOrUpdateHandler(scope.row.id)\">修改</el-button>\r\n                <el-button v-if=\"isAuth('dingdan','删除')\" type=\"text\" icon=\"el-icon-delete\" size=\"small\" @click=\"deleteHandler(scope.row.id)\">删除</el-button>\r\n                </template>\r\n            </el-table-column>\r\n        </el-table>\r\n                                                                                                                                                                                                                                                                                                                                <el-pagination\r\n          @size-change=\"sizeChangeHandle\"\r\n          @current-change=\"currentChangeHandle\"\r\n          :current-page=\"pageIndex\"\r\n          :page-sizes=\"[10, 20, 50, 100]\"\r\n          :page-size=\"pageSize\"\r\n          :total=\"totalPage\"\r\n          layout=\"total, sizes, prev, pager, next, jumper\"\r\n          class=\"pagination-content\"\r\n        ></el-pagination>\r\n      </div>\r\n    </div>\r\n    <!-- 添加/修改页面  将父组件的search方法传递给子组件-->\r\n    <add-or-update v-if=\"addOrUpdateFlag\" :parent=\"this\" ref=\"addOrUpdate\"></add-or-update>\r\n\r\n            <peisongdan-cross-add-or-update v-if=\"peisongdanCrossAddOrUpdateFlag\" :parent=\"this\" ref=\"peisongdanCrossaddOrUpdate\"></peisongdan-cross-add-or-update>\r\n        \r\n        <el-dialog\r\n      title=\"审核\"\n      :visible.sync=\"sfshVisiable\"\n      width=\"50%\">\n      <el-form ref=\"form\" :model=\"form\" label-width=\"80px\">\n        <el-form-item label=\"订单状态\">\n          <el-select v-model=\"shForm.sfsh\" placeholder=\"订单状态\">\n            <el-option v-for=\"item in statusOptions\" :key=\"item\" :label=\"item\" :value=\"item\"></el-option>\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"备注\">\n          <el-input type=\"textarea\" :rows=\"8\" v-model=\"shForm.shhf\"></el-input>\n        </el-form-item>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"shDialog\">取 消</el-button>\r\n        <el-button type=\"primary\" @click=\"shHandler\">确 定</el-button>\r\n      </span>\r\n    </el-dialog>\r\n    \r\n      </div>\r\n</template>\r\n<script>\r\nimport AddOrUpdate from \"./add-or-update\";\r\nimport peisongdanCrossAddOrUpdate from \"../peisongdan/add-or-update\";\r\nexport default {\r\n  data() {\r\n    return {\r\n                                                                                                                                                                                                                                                                                                                                                                                                                  searchForm: {\r\n        key: \"\"\r\n      },\r\n      dataList: [],\r\n      pageIndex: 1,\r\n      pageSize: 10,\r\n      totalPage: 0,\r\n      dataListLoading: false,\r\n      dataListSelections: [],\n      showFlag: true,\n      sfshVisiable: false,\n      statusOptions: ['待接单','已接单','已完成'],\n      shForm: {},\n      chartVisiable: false,\r\n      addOrUpdateFlag:false,\r\n                  peisongdanCrossAddOrUpdateFlag: false,\r\n                };\r\n  },\r\n  mounted() {\r\n    this.init();\r\n    this.getDataList();\r\n  },\r\n  filters: {\r\n    htmlfilter: function (val) {\r\n      return val.replace(/<[^>]*>/g).replace(/undefined/g,'');\r\n    }\r\n  },\r\n  components: {\r\n    AddOrUpdate,\r\n            peisongdanCrossAddOrUpdate,\r\n          },\r\n  methods: {\r\n            peisongdanCrossAddOrUpdateHandler(row,type){\r\n      this.showFlag = false;\r\n      this.addOrUpdateFlag = false;\r\n      this.peisongdanCrossAddOrUpdateFlag = true;\r\n      this.$storage.set('crossObj',row);\r\n      this.$storage.set('crossTable','dingdan');\r\n      this.$nextTick(() => {\r\n        this.$refs.peisongdanCrossaddOrUpdate.init(row.id,type);\r\n      });\r\n    },\r\n                payHandler(row){\r\n      this.$storage.set('paytable','dingdan');\r\n      this.$storage.set('payObject',row);\r\n      this.$router.push('pay');\r\n    },\r\n            init () {\r\n                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      },\r\n    search() {\r\n      this.pageIndex = 1;\r\n      this.getDataList();\r\n    },\r\n    // 获取数据列表\r\n    getDataList() {\r\n      this.dataListLoading = true;\r\n      let params = {\r\n        page: this.pageIndex,\r\n        limit: this.pageSize,\r\n        sort: 'id',\r\n      }\r\n                                          if(this.searchForm.mingcheng!='' && this.searchForm.mingcheng!=undefined){\r\n            params['mingcheng'] = '%' + this.searchForm.mingcheng + '%'\r\n          }\r\n                                                            if(this.searchForm.leixing!='' && this.searchForm.leixing!=undefined){\r\n            params['leixing'] = '%' + this.searchForm.leixing + '%'\r\n          }\r\n                                                                                                                                                    if(this.searchForm.shangjiabianhao!='' && this.searchForm.shangjiabianhao!=undefined){\r\n            params['shangjiabianhao'] = '%' + this.searchForm.shangjiabianhao + '%'\r\n          }\r\n                                                                                                        if(this.searchForm.shouji!='' && this.searchForm.shouji!=undefined){\r\n            params['shouji'] = '%' + this.searchForm.shouji + '%'\r\n          }\r\n                                                                                                                                                                                                                                    this.$http({\r\n        url: \"dingdan/page\",\r\n        method: \"get\",\r\n        params: params\r\n      }).then(({ data }) => {\r\n        if (data && data.code === 0) {\r\n          this.dataList = data.data.list;\r\n          this.totalPage = data.data.total;\r\n        } else {\r\n          this.dataList = [];\r\n          this.totalPage = 0;\r\n        }\r\n        this.dataListLoading = false;\r\n      });\r\n    },\r\n    // 每页数\r\n    sizeChangeHandle(val) {\r\n      this.pageSize = val;\r\n      this.pageIndex = 1;\r\n      this.getDataList();\r\n    },\r\n    // 当前页\r\n    currentChangeHandle(val) {\r\n      this.pageIndex = val;\r\n      this.getDataList();\r\n    },\r\n    // 多选\r\n    selectionChangeHandler(val) {\r\n      this.dataListSelections = val;\r\n    },\r\n    // 添加/修改\r\n    addOrUpdateHandler(id,type) {\r\n      this.showFlag = false;\r\n      this.addOrUpdateFlag = true;\r\n      this.crossAddOrUpdateFlag = false;\r\n      if(type!='info'){\r\n        type = 'else';\r\n      }\r\n      this.$nextTick(() => {\r\n        this.$refs.addOrUpdate.init(id,type);\r\n      });\r\n    },\r\n        // 审核窗口\r\n    shDialog(row){\r\n      this.sfshVisiable = !this.sfshVisiable;\r\n      if(row){\r\n        this.shForm = {\r\n                    mingcheng: row.mingcheng,\r\n                    leixing: row.leixing,\r\n                    tupian: row.tupian,\r\n                    jiage: row.jiage,\r\n                    goumaishuliang: row.goumaishuliang,\r\n                    zongjiage: row.zongjiage,\r\n                    shangjiabianhao: row.shangjiabianhao,\r\n                    shangjiamingcheng: row.shangjiamingcheng,\r\n                    zhanghao: row.zhanghao,\r\n                    shouji: row.shouji,\r\n                    qishoushouyi: row.qishoushouyi,\r\n                    xiadanshijian: row.xiadanshijian,\r\n                    beizhu: row.beizhu,\r\n                    sfsh: row.sfsh,\r\n                    shhf: row.shhf,\r\n                    ispay: row.ispay,\r\n                    longitude: row.longitude,\r\n                    latitude: row.latitude,\r\n                    fulladdress: row.fulladdress,\r\n                    id: row.id\r\n        }\r\n      }\r\n    },\r\n    // 审核\r\n    shHandler(){\r\n      this.$confirm(`确定操作?`, \"提示\", {\r\n        confirmButtonText: \"确定\",\r\n        cancelButtonText: \"取消\",\r\n        type: \"warning\"\r\n      }).then(() => {\r\n        this.$http({\r\n          url: \"dingdan/update\",\r\n          method: \"post\",\r\n          data: this.shForm\r\n        }).then(({ data }) => {\r\n          if (data && data.code === 0) {\r\n            this.$message({\r\n              message: \"操作成功\",\r\n              type: \"success\",\r\n              duration: 1500,\r\n              onClose: () => {\r\n                this.getDataList();\r\n                this.shDialog()\r\n              }\r\n            });\r\n          } else {\r\n            this.$message.error(data.msg);\r\n          }\r\n        });\r\n      });\r\n    },\r\n        // 下载\r\n    download(file){\r\n      window.open(`${file}`)\r\n    },\r\n    // 删除\r\n    deleteHandler(id) {\r\n      var ids = id\r\n        ? [Number(id)]\r\n        : this.dataListSelections.map(item => {\r\n            return Number(item.id);\r\n          });\r\n      this.$confirm(`确定进行[${id ? \"删除\" : \"批量删除\"}]操作?`, \"提示\", {\r\n        confirmButtonText: \"确定\",\r\n        cancelButtonText: \"取消\",\r\n        type: \"warning\"\r\n      }).then(() => {\r\n        this.$http({\r\n          url: \"dingdan/delete\",\r\n          method: \"post\",\r\n          data: ids\r\n        }).then(({ data }) => {\r\n          if (data && data.code === 0) {\r\n            this.$message({\r\n              message: \"操作成功\",\r\n              type: \"success\",\r\n              duration: 1500,\r\n              onClose: () => {\r\n                this.search();\r\n              }\r\n            });\r\n          } else {\r\n            this.$message.error(data.msg);\r\n          }\r\n        });\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n<style lang=\"scss\" scoped>\r\n</style>\r\n"]}]}