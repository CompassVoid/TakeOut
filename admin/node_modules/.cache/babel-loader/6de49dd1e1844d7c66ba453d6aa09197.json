ent\">\r\n                                                                                <el-form-item label=\"商家名称\">\r\n                <el-input v-model=\"searchForm.shangjiamingcheng\" \r\n                    placeholder=\"商家名称\" clearable></el-input>\r\n              </el-form-item>\r\n                                                                                                                        <el-form-item label=\"特色\">\r\n                <el-input v-model=\"searchForm.tese\" \r\n                    placeholder=\"特色\" clearable></el-input>\r\n              </el-form-item>\r\n                                                                          <el-form-item>\r\n          <el-button round @click=\"search()\">查询</el-button>\r\n          <el-button\r\n            v-if=\"isAuth('shangjia','新增')\"\r\n            type=\"primary\"\r\n            @click=\"addOrUpdateHandler()\"\r\n            round\r\n          >新增</el-button>\r\n          <el-button\r\n            v-if=\"isAuth('shangjia','删除')\"\r\n            :disabled=\"dataListSelections.length <= 0\"\r\n            type=\"danger\"\r\n            @click=\"deleteHandler()\"\r\n            round\r\n          >删除</el-button>\r\n                  </el-form-item>\r\n      </el-form>\r\n      <div class=\"table-content\">\r\n        <el-table\r\n            v-if=\"isAuth('shangjia','查看')\"\r\n            :data=\"dataList\"\r\n            border\r\n            v-loading=\"dataListLoading\"\r\n            @selection-change=\"selectionChangeHandler\"\r\n            style=\"width: 100%;\">\r\n            <el-table-column\r\n                type=\"selection\"\r\n                header-align=\"center\"\r\n                align=\"center\"\r\n                width=\"50\">\r\n            </el-table-column>\r\n                                            <el-table-column\r\n                    prop=\"shangjiabianhao\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"商家编号\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.shangjiabianhao}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"mima\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"密码\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.mima}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"shangjiamingcheng\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"商家名称\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.shangjiamingcheng}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                              <el-table-column prop=\"tupian\" \r\n                    header-align=\"center\"\r\n                    align=\"center\" \r\n                    width=\"200\" \r\n                    label=\"图片\">\r\n                    <template slot-scope=\"scope\">\r\n                      <div v-if=\"scope.row.tupian\">\r\n                        <img :src=\"scope.row.tupian.split(',')[0]\" width=\"100\" height=\"100\">\r\n                      </div>\r\n                      <div v-else>无图片</div>\r\n                    </template>\r\n                  </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"lianxiren\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\