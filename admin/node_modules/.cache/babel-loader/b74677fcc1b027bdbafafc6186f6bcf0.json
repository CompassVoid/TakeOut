art.vue"],"sourcesContent":["<template>\n  <div class=\"main-content\">\n    <el-card shadow=\"never\">\n      <div slot=\"header\" class=\"clearfix\">\n        <span>购物车</span>\n        <el-button style=\"float:right\" type=\"text\" @click=\"clearCart\" :disabled=\"items.length===0\">清空</el-button>\n      </div>\n      <el-table :data=\"items\" border v-loading=\"loading\" style=\"width: 100%;\">\n        <el-table-column prop=\"mingcheng\" label=\"商品\" min-width=\"150\">\n          <template slot-scope=\"scope\">\n            <div class=\"cart-item\">\n              <img v-if=\"scope.row.tupian\" :src=\"scope.row.tupian.split(',')[0]\" class=\"thumb\" />\n              <div>\n                <div class=\"name\">{{scope.row.mingcheng}}</div>\n                <div class=\"muted\">{{scope.row.leixing}}</div>\n              </div>\n            </div>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"shangjiamingcheng\" label=\"商家\" min-width=\"120\"></el-table-column>\n        <el-table-column prop=\"jiage\" label=\"单价(元)\" width=\"120\">\n          <template slot-scope=\"scope\">\n            {{Number(scope.row.jiage)||0}}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"数量\" width=\"160\">\n          <template slot-scope=\"scope\">\n            <el-button icon=\"el-icon-minus\" size=\"mini\" @click=\"changeQty(scope.row,-1)\"></el-button>\n            <span class=\"qty\">{{scope.row.goumaishuliang||1}}</span>\n            <el-button icon=\"el-icon-plus\" size=\"mini\" @click=\"changeQty(scope.row,1)\"></el-button>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"小计(元)\" width=\"140\">\n          <template slot-scope=\"scope\">\n            {{(Number(scope.row.jiage)||0) * (scope.row.goumaishuliang||1)}}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"120\" header-align=\"center\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" icon=\"el-icon-delete\" @click=\"removeItem(scope.$index)\">移除</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <div class=\"cart-summary\">\n        <div class=\"summary-left\">\n          <el-form label-width=\"80px\">\n            <el-form-item label=\"收货地址\">\n              <el-input v-model=\"fulladdress\" placeholder=\"请选择地址\" @click.native=\"openMap\"></el-input>\n            </el-form-item>\n            <el-form-item label=\"备注\">\n              <el-input v-model=\"beizhu\" type=\"textarea\" :rows=\"2\" placeholder=\"选填\"></el-input>\n            </el-form-item>\n          </el-form>\n        </div>\n        <div class=\"summary-right\">\n          <div class=\"total\">合计：<span class=\"price\">{{totalPrice}}</span> 元</div>\n          <el-button type=\"primary\" :disabled=\"items.length===0 || !fulladdress\" @click=\"checkout\">结算下单</el-button>\n        </div>\n      </div>\n    </el-card>\n\n    <el-dialog width=\"60%\" title=\"选择地址\" :visible.sync=\"mapVisible\" append-to-body>\n      <el-amap-search-box class=\"search-box\" :on-search-result=\"onSearchResult\" :search-option=\"searchOption\"></el-amap-search-box>\n      <div class=\"amap-wrapper\">\n        <el-amap class=\"amap-box\" :vid=\"'cart-amap'\"\n                 :center=\"center\"\n                 :zoom=\"zoom\"\n                 :events=\"events\">\n          <el-amap-marker v-bind:key=\"marker\" v-for=\"marker in markers\" :position=\"marker\"></el-amap-marker>\n        </el-amap>\n      </div>\n      <div>坐标：[{{ longitude }}, {{ latitude }}]，地址：{{fulladdress}}</div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\n/* global AMap */\nexport default {\n  data() {\n    let self = this\n    return {\n      items: [],\n      loading: false,\n      beizhu: '',\n      fulladdress: '',\n      longitude: '',\n      latitude: '',\n      mapVisible: false,\n      zoom: 12,\n      center: [116.410426, 39.934946],\n      markers: [],\n      searchOption: {\n        citylimit: false\n      },\n      events: {\n        click(e) {\n          let { lng, lat } = e.lnglat\n          self.longitude = lng\n          self.latitude = lat\n          self.markers = [[lng, lat]]\n          var geocoder = new AMap.Geocoder({\n            radius: 1000,\n            extensions: 'all'\n          })\n          geocoder.getAddress([lng, lat], function (status, result) {\n            if (status === 'complete' && result.info === 'OK') {\n              if (result && result.regeocode) {\n                self.fulladdress = result.regeocode.formattedAddress\n              }\n            }\n          })\n        }\n      }\n    }\n  },\n  computed: {\n    totalPrice() {\n      const total = this.items.reduce((sum, item) => {\n        const price = Number(item.jiage) || 0\n        const qty = item.goumaishuliang || 1\n        return sum + price * qty\n      }, 0)\n      return total.toFixed(2)\n    }\n  },\n  mounted() {\n    this.loadCart()\n  },\n  methods: {\n    loadCart() {\n      const list = this.$storage.getObj('cartItems') || []\n      this.items = list.map(item => ({\n        ...item,\n        goumaishuliang: item.goumaishuliang || 1\n      }))\n    },\n    saveCart() {\n      this.$storage.set('cartItems', this.items)\n    },\n    changeQty(row, delta) {\n      const qty = (row.goumaishuliang || 1) + delta\n      row.goumaishuliang = qty > 1 ? qty : 1\n      this.saveCart()\n    },\n    removeItem(index) {\n      this.items.splice(index, 1)\n      this.saveCart()\n    },\n    clearCart() {\n      this.items = []\n      this.saveCart()\n    },\n    openMap() {\n      this.mapVisible = true\n    },\n    onSearchResult(pois) {\n      let latSum = 0\n      let lngSum = 0\n      if (pois.length > 0) {\n        pois.forEach(poi => {\n          let { lng, lat } = poi\n          lngSum += lng\n          latSum += lat\n          this.markers.push([poi.lng, poi.lat])\n        })\n        let center = {\n          lng: lngSum / pois.length,\n          lat: latSum / pois.length\n        }\n        this.center = [center.lng, center.lat]\n      }\n    },\n    checkout() {\n      if (this.items.length === 0) {\n        this.$message.warning(\"购物车为空\")\n        return\n      }\n      const payload = {\n        items: this.items.map(item => ({\n          caipinid: item.id,\n          goumaishuliang: item.goumaishuliang || 1,\n          beizhu: item.beizhu\n        })),\n        beizhu: this.beizhu,\n        fulladdress: this.fulladdress,\n        longitude: this.longitude,\n        latitude: this.latitude\n      }\n      this.loading = true\n      this.$http({\n        url: \"dingdan/checkout\",\n        method: \"post\",\n        data: payload\n      }).then(({ data }) => {\n        if (data && data.code === 0) {\n          this.$message.success(\"下单成功\")\n          this.clearCart()\n        } else {\n          this.$message.error(data.msg || \"下单失败\")\n        }\n      }).finally(() => {\n        this.loading = false\n      })\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.cart-item {\n  display: flex;\n  align-items: center;\n  .thumb {\n    width: 60px;\n    height: 60px;\n    margin-right: 12px;\n    object-fit: cover;\n    border-radius: 4px;\n  }\n  .name {\n    font-weight: bold;\n  }\n  .muted {\n    color: #888;\n    font-size: 12px;\n  }\n}\n.qty {\n  display: inline-block;\n  width: 40px;\n  text-align: center;\n}\n.cart-summary {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-top: 20px;\n  flex-wrap: wrap;\n  .summary-left {\n    flex: 1 1 60%;\n    min-width: 300px;\n  }\n  .summary-right {\n    flex: 1 1 30%;\n    min-width: 200px;\n    text-align: right;\n    .total {\n      font-size: 18px;\n      margin-bottom: 10px;\n      .price {\n        color: #f56c6c;\n        font-weight: bold;\n      }\n    }\n  }\n}\n.amap-wrapper {\n  width: 100%;\n  height: 400px;\n  margin-top: 10px;\n}\n.search-box {\n  position: absolute;\n  z-index: 10;\n  width: 260px;\n}\n</style>\n"],"mappings":";;;;;;;;;;AA6EA;AACA;EACAA,IAAA,WAAAA,KAAA;IACA,IAAAC,IAAA;IACA;MACAC,KAAA;MACAC,OAAA;MACAC,MAAA;MACAC,WAAA;MACAC,SAAA;MACAC,QAAA;MACAC,UAAA;MACAC,IAAA;MACAC,MAAA;MACAC,OAAA;MACAC,YAAA;QACAC,SAAA;MACA;MACAC,MAAA;QACAC,KAAA,WAAAA,MAAAC,CAAA;UACA,IAAAC,SAAA,GAAAD,CAAA,CAAAE,MAAA;YAAAC,GAAA,GAAAF,SAAA,CAAAE,GAAA;YAAAC,GAAA,GAAAH,SAAA,CAAAG,GAAA;UACAnB,IAAA,CAAAK,SAAA,GAAAa,GAAA;UACAlB,IAAA,CAAAM,QAAA,GAAAa,GAAA;UACAnB,IAAA,CAAAU,OAAA,KAAAQ,GAAA,EAAAC,GAAA;UACA,IAAAC,QAAA,OAAAC,IAAA,CAAAC,QAAA;YACAC,MAAA;YACAC,UAAA;UACA;UACAJ,QAAA,CAAAK,UAAA,EAAAP,GAAA,EAAAC,GAAA,aAAAO,MAAA,EAAAC,MAAA;YACA,IAAAD,MAAA,mBAAAC,MAAA,CAAAC,IAAA;cACA,IAAAD,MAAA,IAAAA,MAAA,CAAAE,SAAA;gBACA7B,IAAA,CAAAI,WAAA,GAAAuB,MAAA,CAAAE,SAAA,CAAAC,gBAAA;cACA;YACA;UACA;QACA;MACA;IACA;EACA;EACAC,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,IAAAC,KAAA,QAAAhC,KAAA,CAAAiC,MAAA,WAAAC,GAAA,EAAAC,IAAA;QACA,IAAAC,KAAA,GAAAC,MAAA,CAAAF,IAAA,CAAAG,KAAA;QACA,IAAAC,GAAA,GAAAJ,IAAA,CAAAK,cAAA;QACA,OAAAN,GAAA,GAAAE,KAAA,GAAAG,GAAA;MACA;MACA,OAAAP,KAAA,CAAAS,OAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,QAAA;EACA;EACAC,OAAA;IACAD,QAAA,WAAAA,SAAA;MACA,IAAAE,IAAA,QAAAC,QAAA,CAAAC,MAAA;MACA,KAAA/C,KAAA,GAAA6C,IAAA,CAAAG,GAAA,WAAAb,IAAA;QAAA,OAAAc,aAAA,CAAAA,aAAA,KACAd,IAAA;UACAK,cAAA,EAAAL,IAAA,CAAAK,cAAA;QAAA;MAAA,CACA;IACA;IACAU,QAAA,WAAAA,SAAA;MACA,KAAAJ,QAAA,CAAAK,GAAA,mBAAAnD,KAAA;IACA;IACAoD,SAAA,WAAAA,UAAAC,GAAA,EAAAC,KAAA;MACA,IAAAf,GAAA,IAAAc,GAAA,CAAAb,cAAA,SAAAc,KAAA;MACAD,GAAA,CAAAb,cAAA,GAAAD,GAAA,OAAAA,GAAA;MACA,KAAAW,QAAA;IACA;IACAK,UAAA,WAAAA,WAAAC,KAAA;MACA,KAAAxD,KAAA,CAAAyD,MAAA,CAAAD,KAAA;MACA,KAAAN,QAAA;IACA;IACAQ,SAAA,WAAAA,UAAA;MACA,KAAA1D,KAAA;MACA,KAAAkD,QAAA;IACA;IACAS,OAAA,WAAAA,QAAA;MACA,KAAArD,UAAA;IACA;IACAsD,cAAA,WAAAA,eAAAC,IAAA;MAAA,IAAAC,KAAA;MACA,IAAAC,MAAA;MACA,IAAAC,MAAA;MACA,IAAAH,IAAA,CAAAI,MAAA;QACAJ,IAAA,CAAAK,OAAA,WAAAC,GAAA;UACA,IAAAlD,GAAA,GAAAkD,GAAA,CAAAlD,GAAA;YAAAC,GAAA,GAAAiD,GAAA,