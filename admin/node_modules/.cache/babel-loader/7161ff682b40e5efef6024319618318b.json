":["src/views/modules/qishou/add-or-update.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-form\r\n      class=\"detail-form-content\"\r\n      ref=\"ruleForm\"\r\n      :model=\"ruleForm\"\r\n      :rules=\"rules\"\r\n      label-width=\"80px\"\r\n    >\r\n      <el-row>\r\n                  <el-col :span=\"12\">\r\n        <el-form-item  v-if=\"type!='info'\"  label=\"用户名\" prop=\"yonghuming\">\r\n          <el-input v-model=\"ruleForm.yonghuming\" \r\n              placeholder=\"用户名\" clearable></el-input>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.yonghuming\" label=\"用户名\" prop=\"yonghuming\">\r\n              <el-input v-model=\"ruleForm.yonghuming\" \r\n                placeholder=\"用户名\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item  v-if=\"type!='info'\"  label=\"密码\" prop=\"mima\">\r\n          <el-input v-model=\"ruleForm.mima\" \r\n              placeholder=\"密码\" clearable></el-input>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.mima\" label=\"密码\" prop=\"mima\">\r\n              <el-input v-model=\"ruleForm.mima\" \r\n                placeholder=\"密码\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item  v-if=\"type!='info'\"  label=\"骑手姓名\" prop=\"qishouxingming\">\r\n          <el-input v-model=\"ruleForm.qishouxingming\" \r\n              placeholder=\"骑手姓名\" clearable></el-input>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.qishouxingming\" label=\"骑手姓名\" prop=\"qishouxingming\">\r\n              <el-input v-model=\"ruleForm.qishouxingming\" \r\n                placeholder=\"骑手姓名\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item v-if=\"type!='info'\"  label=\"性别\" prop=\"xingbie\">\r\n          <el-select v-model=\"ruleForm.xingbie\" placeholder=\"请选择性别\">\r\n            <el-option\r\n                v-for=\"(item,index) in xingbieOptions\"\r\n                v-bind:key=\"index\"\r\n                :label=\"item\"\r\n                :value=\"item\">\r\n            </el-option>\r\n          </el-select>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.xingbie\" label=\"性别\" prop=\"xingbie\">\r\n              <el-input v-model=\"ruleForm.xingbie\" \r\n                placeholder=\"性别\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"24\">  \r\n        <el-form-item v-if=\"type!='info'\" label=\"头像\" prop=\"touxiang\">\r\n          <file-upload\r\n          tip=\"点击上传头像\"\r\n          action=\"file/upload\"\r\n          :limit=\"3\"\r\n          :multiple=\"true\"\r\n          :fileUrls=\"ruleForm.touxiang?ruleForm.touxiang:''\"\r\n          @change=\"touxiangUploadChange\"\r\n          ></file-upload>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.touxiang\" label=\"头像\" prop=\"touxiang\">\r\n            <img style=\"margin-right:20px;\" v-bind:key=\"index\" v-for=\"(item,index) in ruleForm.touxiang.split(',')\" :src=\"item\" width=\"100\" height=\"100\">\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        <el-col :span=\"12\">\r\n        <el-form-item  v-if=\"type!='info'\"  label=\"电话\" prop=\"dianhua\">\r\n          <el-input v-model=\"ruleForm.dianhua\" \r\n              placeholder=\"电话\" clearable></el-input>\r\n        </el-form-item>\r\n        <div v-else>\r\n          <el-form-item v-if=\"ruleForm.dianhua\" label=\"电话\" prop=\"dianhua\">\r\n              <el-input v-model=\"ruleForm.dianhua\" \r\n                placeholder=\"电话\" readonly></el-input>\r\n          </el-form-item>\r\n        </div>\r\n      </el-col>\r\n                        </el-row>\r\n                                                                                                                                                                                          <el-form-item>\r\n                <el-button v-if=\"type!='info'\" type=\"primary\" @click=\"onSubmit\">提交</el-button>\r\n        <el-button v-if=\"type!='info'\" @click=\"back()\">取消</el-button>\r\n        <el-button v-if=\"type=='info'\" @click=\"back()\">返回</el-button>\r\n      </el-form-item>\r\n    </el-form>\r\n    \r\n    \r\n  </div>\r\n</template>\r\n<script>\r\n// 数字，邮件，手机，url，身份证校验\r\nimport { isNumber,isIntNumer,isEmail,isMobile,isURL,checkIdCard } from \"@/utils/validate\";\r\nexport default {\r\n  data() {\r\n    let self = this\r\n    var validateIdCard = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!checkIdCard(value)) {\r\n        callback(new Error(\"请输入正确的身份证号码\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validateUrl = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isURL(value)) {\r\n        callback(new Error(\"请输入正确的URL地址\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validatePhone = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isMobile(value)) {\r\n        callback(new Error(\"请输入正确的电话号码\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validateEmail = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isEmail(value)) {\r\n        callback(new Error(\"请输入正确的邮箱地址\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validateNumber = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isNumber(value)) {\r\n        callback(new Error(\"请输入数字\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    var validateIntNumber = (rule, value, callback) => {\r\n      if(!value){\r\n        callback();\r\n      } else if (!isIntNumer(value)) {\r\n        callback(new Error(\"请输入整数\"));\r\n      } else {\r\n        callback();\r\n      }\r\n    };\r\n    return {\r\n      id: '',\r\n      type: '',\r\n            ruleForm: {\r\n                        yonghuming: '',\r\n                                mima: '',\r\n                                qishouxingming: '',\r\n                                xingbie: '',\r\n                                touxiang: '',\r\n                                dianhua: '',\r\n                      },\r\n                                                                  xingbieOptions: [],\r\n                                                rules: {\r\n                  yonghuming: [\r\n                            { required: true, message: '用户名不能为空', trigger: 'blur' },\r\n                                                                                              ],\r\n                  mima: [\r\n                            { required: true, message: '密码不能为空', trigger: 'blur' },\r\n                                                                                              ],\r\n                  qishouxingming: [\r\n                                                                                              ],\r\n                  xingbie: [\r\n                                                                                              ],\r\n                  touxiang: [\r\n                                                                                              ],\r\n                  dianhua: [\r\n                                                                { validator: validatePhone, trigger: 'blur' },\r\n                                                          ],\r\n              }\r\n    };\r\n  },\r\n  props: [\"parent\"],\r\n  computed: {\r\n                                                                              },\r\n  methods: {\r\n        // 下载\r\n    download(file){\r\n      window.open(`${file}`)\r\n    },\r\n    // 初始化\r\n    init(id,type) {\r\n      if (id) {\r\n        this.id = id;\r\n        this.type = type;\r\n      }\r\n      if(this.type=='info'||this.type=='else'){\r\n        this.info(id);\r\n      }else if(this.type=='cross'){\r\n        var obj = this.$storage.getObj('crossObj');\r\n        for (var o in obj){\r\n                    if(o=='yonghuming'){\r\n            this.ruleForm.yonghuming = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='mima'){\r\n            this.ruleForm.mima = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='qishouxingming'){\r\n            this.ruleForm.qishouxingming = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='xingbie'){\r\n            this.ruleForm.xingbie = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='touxiang'){\r\n            this.ruleForm.touxiang = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='dianhua'){\r\n            this.ruleForm.dianhua = obj[o];\r\n            continue;\r\n          }\r\n                  }\r\n                                                                                                              }\r\n                                                                                                this.xingbieOptions = \"男,女\".split(',')\r\n                                                                },\r\n                                                        // 多级联动参数\r\n                                                                        info(id) {\r\n      this.$http({\r\n        url: `qishou/info/${id}`,\r\n        method: \"get\"\r\n      }).then(({ data }) => {\r\n        if (data && data.code === 0) {\r\n          this.ruleForm = data.data;\r\n        } else {\r\n          this.$message.error(data.msg);\r\n        }\r\n      });\r\n    },\r\n        // 提交\r\n    onSubmit() {\r\n                  // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                                                                                                                                                this.$refs[\"ruleForm\"].validate(valid => {\r\n        if (valid) {\r\n          this.$http({\r\n            url: `qishou/${!this.ruleForm.id ? \"save\" : \"update\"}`,\r\n            method: \"post\",\r\n            data: this.ruleForm\r\n          }).then(({ data }) => {\r\n            if (data && data.code === 0) {\r\n              this.$message({\r\n                message: \"操作成功\",\r\n                type: \"success\",\r\n                duration: 1500,\r\n                onClose: () => {\r\n                  this.parent.showFlag = true;\r\n                  this.parent.addOrUpdateFlag = false;\r\n                  this.parent.qishouCrossAddOrUpdateFlag = false;\r\n                  this.parent.search();\r\n                }\r\n              });\r\n            } else {\r\n              this.$message.error(data.msg);\r\n            }\r\n          });\r\n        }\r\n      });\r\n    },\r\n    // 获取uuid\r\n    getUUID () {\r\n      return new Date().getTime();\r\n    },\r\n    // 返回\r\n    back() {\r\n      this.parent.showFlag = true;\r\n      this.parent.addOrUpdateFlag = false;\r\n      this.parent.qishouCrossAddOrUpdateFlag = false;\r\n    },\r\n                                                                        touxiangUploadChange(fileUrls) {\r\n                this.ruleForm.touxiang = fileUrls;\r\n            },\r\n                          }\r\n};\r\n</script>\r\n<style lang=\"scss\">\r\n.editor{\r\n  height: 500px;\r\n}\r\n.amap-wrapper {\r\n  width: 100%;\r\n  height: 500px;\r\n}\r\n.search-box {\r\n  position: absolute;\r\n}\r\n</style>\r\n"],"mappings":";;;;AAyGA;AACA,SAAAA,QAAA,EAAAC,UAAA,EAAAC,OAAA,EAAAC,QAAA,EAAAC,KAAA,EAAAC,WAAA;AACA;EACAC,IAAA,WAAAA,KAAA;IACA,IAAAC,IAAA;IACA,IAAAC,cAAA,YAAAA,eAAAC,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,KAAAD,KAAA;QACAC,QAAA;MACA,YAAAN,WAAA,CAAAK,KAAA;QACAC,QAAA,KAAAC,KAAA;MACA;QACAD,QAAA;MACA;IACA;IACA,IAAAE,WAAA,YAAAA,YAAAJ,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,KAAAD,KAAA;QACAC,QAAA;MACA,YAAAP,KAAA,CAAAM,KAAA;QACAC,QAAA,KAAAC,KAAA;MACA;QACAD,QAAA;MACA;IACA;IACA,IAAAG,aAAA,YAAAA,cAAAL,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,KAAAD,KAAA;QACAC,QAAA;MACA,YAAAR,QAAA,CAAAO,KAAA;QACAC,QAAA,KAAAC,KAAA;MACA;QACAD,QAAA;MACA;IACA;IACA,IAAAI,aAAA,YAAAA,cAAAN,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,KAAAD,KAAA;QACAC,QAAA;MACA,YAAAT,OAAA,CAAAQ,KAAA;QACAC,QAAA,KAAAC,KAAA;MACA;QACAD,QAAA;MACA;IACA;IACA,IAAAK,cAAA,YAAAA,eAAAP,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,KAAAD,KAAA;QACAC,QAAA;MACA,YAAAX,QAAA,CAAAU,KAAA;QACAC,QAAA,KAAAC,KAAA;MACA;QACAD,QAAA;MACA;IACA;IACA,IAAAM,iBAAA,YAAAA,kBAAAR,IAAA,EAAAC,KAAA,EAAAC,QAAA;MACA,KAAAD,KAAA;QACAC,QAAA;MACA,YAAAV,UAAA,CAAAS,KAAA;QACAC,QAAA,KAAAC,KAAA;MACA;QACAD,QAAA;MACA;IACA;IACA;MACAO,EAAA;MACAC,IAAA;MACAC,QAAA;QACAC,UAAA;QACAC,IAAA;QACAC,cAAA;QACAC,OAAA;QACAC,QAAA;QACAC,OAAA;MACA;MACAC,cAAA;MACAC,KAAA;QACAP,UAAA,GACA;UAAAQ,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAT,IAAA,GACA;UAAAO,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAR,cAAA,IACA;QACAC,OAAA,IACA;QACAC,QAAA,IACA;QACAC,OAAA,GACA;UAAAM,SAAA,EAAAlB,aAAA;UAAAiB,OAAA;QAAA;MAEA;IACA;EACA;EACAE,KAAA;EACAC,QAAA,GACA;EACAC,OAAA;IACA;IACAC,QAAA,WAAAA,SAAAC,IAAA;MACAC,MAAA,CAAAC,IAAA,IAAAC,MAAA,CAAAH,IAAA;IACA;IACA;IACAI,IAAA,WAAAA,KAAAvB,EAAA,EAAAC,IAAA;MACA,IAAAD,EAAA;QACA,KAAAA,EAAA,GAAAA,EAAA;QACA,KAAAC,IAAA,GAAAA,IAAA;MACA;MACA,SAAAA,IAAA,mBAAAA,IAAA;QACA,KAAAuB,IAAA,CAAAxB,EAAA;MACA,gBAAAC,I