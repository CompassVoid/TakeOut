    });\n    },\n    addToCart(row){\n      const cart = this.$storage.getObj('cartItems') || []\n      const found = cart.find(item => item.id === row.id)\n      if(found){\n        found.goumaishuliang = (found.goumaishuliang || found.quantity || 1) + 1\n      }else{\n        cart.push({\n          id: row.id,\n          mingcheng: row.mingcheng,\n          leixing: row.leixing,\n          tupian: row.tupian,\n          jiage: row.jiage,\n          shangjiabianhao: row.shangjiabianhao,\n          shangjiamingcheng: row.shangjiamingcheng,\n          goumaishuliang: 1\n        })\n      }\n      this.$storage.set('cartItems', cart)\n      this.$message.success('已加入购物车')\n    },\n                    init () {\n                                                        this.$http({\n            url: `option/caipinfenlei/leixing`,\n            method: \"get\"\n          }).then(({ data }) => {\r\n            if (data && data.code === 0) {\r\n              this.leixingOptions = data.data;\r\n            } else {\r\n              this.$message.error(data.msg);\r\n            }\r\n          });\r\n                                                                                                                                                                                                                                                },\r\n    search() {\r\n      this.pageIndex = 1;\r\n      this.getDataList();\r\n    },\r\n    // 获取数据列表\r\n    getDataList() {\r\n      this.dataListLoading = true;\r\n      let params = {\r\n        page: this.pageIndex,\r\n        limit: this.pageSize,\r\n        sort: 'id',\r\n      }\r\n                                          if(this.searchForm.mingcheng!='' && this.searchForm.mingcheng!=undefined){\r\n            params['mingcheng'] = '%' + this.searchForm.mingcheng + '%'\r\n          }\r\n                                                            if(this.searchForm.leixing!='' && this.searchForm.leixing!=undefined){\r\n            params['leixing'] = '%' + this.searchForm.leixing + '%'\r\n          }\r\n                                                                                                                                                                                        this.$http({\r\n        url: \"caipin/page\",\r\n        method: \"get\",\r\n        params: params\r\n      }).then(({ data }) => {\r\n        if (data && data.code === 0) {\r\n          this.dataList = data.data.list;\r\n          this.totalPage = data.data.total;\r\n        } else {\r\n          this.dataList = [];\r\n          this.totalPage = 0;\r\n        }\r\n        this.dataListLoading = false;\r\n      });\r\n    },\r\n    // 每页数\r\n    sizeChangeHandle(val) {\r\n      this.pageSize = val;\r\n      this.pageIndex = 1;\r\n      this.getDataList();\r\n    },\r\n    // 当前页\r\n    currentChangeHandle(val) {\r\n      this.pageIndex = val;\r\n      this.getDataList();\r\n    },\r\n    // 多选\r\n    selectionChangeHandler(val) {\r\n      this.dataListSelections = val;\r\n    },\r\n    // 添加/修改\r\n    addOrUpdateHandler(id,type) {\r\n      this.showFlag = false;\r\n      this.addOrUpdateFlag = true;\r\n      this.crossAddOrUpdateFlag = false;\r\n      if(type!='info'){\r\n        type = 'else';\r\n      }\r\n      this.$nextTick(() => {\r\n        this.$refs.addOrUpdate.init(id,type);\r\n      });\r\n    },\r\n        // 下载\r\n    download(file){\r\n      window.open(`${file}`)\r\n    },\r\n    // 删除\r\n    deleteHandler(id) {\r\n      var ids = id\r\n        ? [Number(id)]\r\n        : this.dataListSelections.map(item => {\r\n            return Number(item.id);\r\n          });\r\n      this.$confirm(`确定进行[${id ? \"删除\" : \"批量删除\"}]操作?`, \"提示\", {\r\n        confirmButtonText: \"确定\",\r\n        cancelButtonText: \"取消\",\r\n        type: \"warning\"\r\n      }).then(() => {\r\n        this.$http({\r\n          url: \"caipin/delete\",\r\n          method: \"post\",\r\n          data: ids\r\n        }).then(({ data }) => {\r\n          if (data && data.code === 0) {\r\n            this.$message({\r\n              message: \"操作成功\",\r\n              type: \"success\",\r\n              duration: 1500,\r\n              onClose: () => {\r\n                this.search();\r\n              }\r\n            });\r\n          } else {\r\n            this.$message.error(data.msg);\r\n          }\r\n        });\r\n      });\r\n    }\r\n  }\r\n};\r\n</script>\r\n<style lang=\"scss\" scoped>\r\n</style>\r\n"],"mappings":";;;;;;;;AAgKA,OAAAA,WAAA;AACA,OAAAC,uBAAA;AACA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,cAAA;MACAC,UAAA;QACAC,GAAA;MACA;MACAC,QAAA;MACAC,SAAA;MACAC,QAAA;MACAC,SAAA;MACAC,eAAA;MACAC,kBAAA;MACAC,QAAA;MACAC,YAAA;MACAC,MAAA;MACAC,aAAA;MACAC,eAAA;MACAC,2BAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,IAAA;IACA,KAAAC,WAAA;EACA;EACAC,OAAA;IACAC,UAAA,WAAAA,WAAAC,GAAA;MACA,OAAAA,GAAA,CAAAC,OAAA,aAAAA,OAAA;IACA;EACA;EACAC,UAAA;IACAzB,WAAA,EAAAA,WAAA;IACAC,uBAAA,EAAAA;EACA;EACAyB,OAAA;IACAC,8BAAA,WAAAA,+BAAAC,GAAA,EAAAC,IAAA;MAAA,IAAAC,KAAA;MACA,KAAAlB,QAAA;MACA,KAAAI,eAAA;MACA,KAAAC,2BAAA;MACA,KAAAc,QAAA,CAAAC,GAAA,aAAAJ,GAAA;MACA,KAAAG,QAAA,CAAAC,GAAA;MACA,KAAAC,SAAA;QACAH,KAAA,CAAAI,KAAA,CAAAC,uBAAA,CAAAhB,IAAA,CAAAS,GAAA,CAAAQ,EAAA,EAAAP,IAAA;MACA;IACA;IACAQ,SAAA,WAAAA,UAAAT,GAAA;MACA,IAAAU,IAAA,QAAAP,QAAA,CAAAQ,MAAA;MACA,IAAAC,KAAA,GAAAF,IAAA,CAAAG,IAAA,WAAAC,IAAA;QAAA,OAAAA,IAAA,CAAAN,EAAA,KAAAR,GAAA,CAAAQ,EAAA;MAAA;MACA,IAAAI,KAAA;QACAA,KAAA,CAAAG,cAAA,IAAAH,KAAA,CAAAG,cAAA,IAAAH,KAAA,CAAAI,QAAA;MACA;QACAN,IAAA,CAAAO,IAAA;UACAT,EAAA,EAAAR,GAAA,CAAAQ,EAAA;UACAU,SAAA,EAAAlB,GAAA,CAAAkB,SAAA;UACAC,OAAA,EAAAnB,GAAA,CAAAmB,OAAA;UACAC,MAAA,EAAApB,GAAA,CAAAoB,MAAA;UACAC,KAAA,EAAArB,GAAA,CAAAqB,KAAA;UACAC,eAAA,EAAAtB,GAAA,CAAAsB,eAAA;UACAC,iBAAA,EAAAvB,GAAA,CAAAuB,iBAAA;UACAR,cAAA;QACA;MACA;MACA,KAAAZ,QAAA,CAAAC,GAAA,cAAAM,IAAA;MACA,KAAAc,QAAA,CAAAC,OAAA;IACA;IACAlC,IAAA,WAAAA,KAAA;MAAA,IAAAmC,MAAA;MACA,KAAAC,KAAA;QACAC,GAAA;QACAC,MAAA;MACA,GAAAC,IAAA,WAAAC,IAAA;QAAA,IAAAzD,IAAA,GAAAyD,IAAA,CAA