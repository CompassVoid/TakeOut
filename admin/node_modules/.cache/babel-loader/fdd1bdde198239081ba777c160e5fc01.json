r\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"口味\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.kouwei}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"jiage\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"价格\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.jiage}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"shangjiabianhao\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"商家编号\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.shangjiabianhao}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"shangjiamingcheng\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"商家名称\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.shangjiamingcheng}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                            <el-table-column\r\n                    prop=\"dizhi\"\r\n                    header-align=\"center\"\r\n                    align=\"center\"\r\n                    sortable\r\n                    label=\"地址\">\r\n                    <template slot-scope=\"scope\">\r\n                      {{scope.row.dizhi}}\r\n                    </template>\r\n                </el-table-column>\r\n                                                                                                <el-table-column\r\n                header-align=\"center\"\r\n                align=\"center\"\r\n                label=\"操作\">\r\n                <template slot-scope=\"scope\">\n                                <el-button v-if=\"isAuth('caipin','查看')\" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"addOrUpdateHandler(scope.row.id,'info')\">详情</el-button>\n                                                                <el-button v-if=\"isAuth('caipin','加入订餐车')\" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"dingdanCrossAddOrUpdateHandler(scope.row,'cross')\">加入订餐车</el-button>\n                                                                <el-button v-if=\"isAuth('caipin','加入订餐车')\" type=\"text\" icon=\"el-icon-shopping-cart-full\" size=\"small\" @click=\"addToCart(scope.row)\">加入购物车</el-button>\n                                                                <el-button v-if=\"isAuth('caipin','修改')\" type=\"text\" icon=\"el-icon-edit\" size=\"small\" @click=\"addOrUpdateHandler(scope.row.id)\">修改</el-button>\n                <el-button v-if=\"isAuth('caipin','删除')\" type=\"text\" icon=\"el-icon-delete\" size=\"small\" @click=\"deleteHandler(scope.row.id)\">删除</el-button>\n                </template>\n            </el-table-column>\r\n        </el-table>\r\n                                                                                                                                                                <el-pagination\r\n          @size-change=\"sizeChangeHandle\"\r\n          @current-change=\"currentChangeHandle\"\r\n          :current-page=\"pageIndex\"\r\n          :page-sizes=\"[10, 20, 50, 100]\"\r\n          :page-size=\"pageSize\"\r\n          :total=\"totalPage\"\r\n          layout=\"total, sizes, p