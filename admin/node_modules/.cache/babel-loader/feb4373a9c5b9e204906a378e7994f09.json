[o];\r\n            continue;\r\n          }\r\n                    if(o=='jieshao'){\r\n            this.ruleForm.jieshao = obj[o];\r\n            continue;\r\n          }\r\n                  }\r\n                                                                                                                                                              }\r\n                                                                                                                                                                                                },\r\n                                                                                // 多级联动参数\r\n                                                                                                      info(id) {\r\n      this.$http({\r\n        url: `shangjia/info/${id}`,\r\n        method: \"get\"\r\n      }).then(({ data }) => {\r\n        if (data && data.code === 0) {\r\n          this.ruleForm = data.data;\r\n        } else {\r\n          this.$message.error(data.msg);\r\n        }\r\n      });\r\n    },\r\n        // 提交\r\n    onSubmit() {\r\n                  // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                              // ${column.compare}\r\n                                                                                                                                                                                                      this.$refs[\"ruleForm\"].validate(valid => {\r\n        if (valid) {\r\n          this.$http({\r\n            url: `shangjia/${!this.ruleForm.id ? \"save\" : \"update\"}`,\r\n            method: \"post\",\r\n           