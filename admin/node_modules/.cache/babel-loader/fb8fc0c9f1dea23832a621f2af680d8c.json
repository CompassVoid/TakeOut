        this.ruleForm.shangjiabianhao = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='shangjiamingcheng'){\r\n            this.ruleForm.shangjiamingcheng = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='dizhi'){\r\n            this.ruleForm.dizhi = obj[o];\r\n            continue;\r\n          }\r\n                    if(o=='caipinjieshao'){\r\n            this.ruleForm.caipinjieshao = obj[o];\r\n            continue;\r\n          }\r\n                  }\r\n                                                                                                                                                              }\r\n            // 获取用户信息\r\n      this.$http({\r\n        url: `${this.$storage.get('sessionTable')}/session`,\r\n        method: \"get\"\r\n      }).then(({ data }) => {\r\n        if (data && data.code === 0) {\r\n          var json = data.data;\r\n                                                                                                                                                  this.ruleForm.shangjiabianhao = json.shangjiabianhao\r\n                                                this.ruleForm.shangjiamingcheng = json.shangjiamingcheng\r\n                                                this.ruleForm.dizhi = json.dizhi\r\n                                                    } else {\r\n          this.$message.error(data.msg);\r\n        }\r\n      });\r\n                                                            this.$http({\r\n              url: `option/caipinfenlei/leixing`,\r\n              method: \"get\"\r\n            }).then(({ data }) => {\r\n              if (data && data.code === 0) {\r\n                this.leixingOptions = data.data;\r\n              } else {\r\n                this.$message.error(data.msg);\r\n              }\r\n            });\r\n         \r\n                                                                                                           